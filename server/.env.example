# Server
PORT=3001

# Database (nombres deben coincidir EXACTO con los que lee server.js)
MYSQL_HOST=localhost
MYSQL_USER=your_db_user
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=your_db_name

# Email (Nodemailer)
EMAIL_HOST=your_email_host
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password
EMAIL_CC=juanmanuel@ecommetrica.com

# ─── CRM ───────────────────────────────────────────────────────────────────────
#
# El CRM comparte la base de datos y el transporte de email de arriba: no hay
# MYSQL_* ni EMAIL_* duplicados para el. Solo variables propias.
#
# Ver crm/db/schema.sql (aplicar a mano, una vez) y crm/seed.js (correr a mano,
# una vez) antes de arrancar con esto.

# Auth. OBLIGATORIA. Sin ella el login falla con un error explicito, no con un
# token predecible. Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRM_JWT_SECRET=

# Remitente del CRM. El calendario usa siempre EMAIL_USER; el CRM necesita poder
# poner "Reforma Dental <hola@...>" en el From, asi que va aparte.
CRM_SMTP_FROM="Reforma Dental <citas@reformadental.com>"

# Facebook Lead Ads: polling de leads nuevos. Sin esto el sync cada 5 minutos
# se salta y lo registra en Settings.
CRM_FB_PAGE_ACCESS_TOKEN=
CRM_FB_PAGE_ID=

# Facebook Conversions API. Opcional: sin token, los cambios de etapa no se
# reportan a Meta y no se pierde nada mas que la atribucion.
CRM_FB_CAPI_ACCESS_TOKEN=
# Mientras tenga valor, todos los eventos CAPI se envian en modo prueba y Meta
# NO los cuenta. Dejar vacio en produccion.
CRM_FB_CAPI_TEST_EVENT_CODE=

# SMS por Twilio. Las dos reglas de SMS/WhatsApp llegan desactivadas porque
# dependen de esto. Poner las claves aqui y activarlas en Settings.
CRM_TWILIO_ACCOUNT_SID=
CRM_TWILIO_AUTH_TOKEN=
CRM_TWILIO_FROM_SMS_NUMBER=

# WhatsApp Cloud API.
CRM_WHATSAPP_ACCESS_TOKEN=
CRM_WHATSAPP_PHONE_NUMBER_ID=
