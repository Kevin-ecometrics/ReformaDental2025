# Copiar a .env (o cargar en cPanel -> Setup Node.js App -> Environment variables)
# y reemplazar los valores de ejemplo. Nunca subir el .env real a git.
#
# Las lineas comentadas (#) son OPCIONALES: el codigo trata cualquier variable con
# valor como "configurada", asi que un placeholder activo por descuido haria creer
# que la integracion funciona. Descomentar solo cuando se tenga el valor real.

# ─── Server ────────────────────────────────────────────────────────────────────
# El puerto esta fijo en 3001 dentro de server.js; esta variable no se lee.
PORT=3001

# ─── Base de datos (compartida por el calendario y el CRM) ─────────────────────
# Nombres exactos que lee server.js. En cPanel el usuario y la base llevan el
# prefijo de la cuenta: <cuenta>_usuario, <cuenta>_base.
MYSQL_HOST=localhost
MYSQL_USER=cpanelaccount_dbuser
MYSQL_PASSWORD=your_db_password
MYSQL_DATABASE=cpanelaccount_dbname

# ─── Email (Nodemailer) ────────────────────────────────────────────────────────
# El calendario y el CRM comparten este transporte; el CRM envia desde EMAIL_USER.
EMAIL_HOST=mail.your-domain.com
EMAIL_USER=noreply@your-domain.com
EMAIL_PASS=your_email_password
EMAIL_CC=copy-to@your-domain.com
# Definidas en cPanel pero server.js hoy las ignora (puerto 465 y secure fijos).
# EMAIL_PORT=465
# EMAIL_SECURE=true

# ─── CRM ───────────────────────────────────────────────────────────────────────
#
# El CRM comparte la base de datos y el transporte de email de arriba: no hay
# MYSQL_* ni EMAIL_* duplicados para el. Solo variables propias, con prefijo CRM_.
#
# Antes de arrancar: aplicar schema.sql a mano (una vez) y correr
#   node server.js --crm-seed
#   node server.js --crm-create-user <email> "<nombre>"
# Comprobar el resultado con GET /health.

# Auth. OBLIGATORIA (minimo 32 caracteres). Sin ella el login falla con un error
# explicito. Generar una propia con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
CRM_JWT_SECRET=replace_with_48_random_bytes_in_hex_min_32_chars

# Ruta POST /crm/cron/tick, para el Cron Jobs de cPanel (cada 5 min, con curl). El
# cron interno muere cuando el hosting detiene la app por falta de trafico; esta
# ruta la levanta y corre el sync dentro. Se manda en la cabecera X-Cron-Token.
# OPCIONAL: sin ella (o con menos de 32 caracteres) la ruta queda apagada. Generar:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# CRM_CRON_TOKEN=replace_with_48_random_bytes_in_hex_min_32_chars

# Facebook Lead Ads: polling de leads nuevos cada 5 min. Sin estas dos el sync se
# salta y queda registrado en Settings. Recomendadas.
CRM_FB_PAGE_ACCESS_TOKEN=your_facebook_page_access_token
CRM_FB_PAGE_ID=your_facebook_page_id

# ── Opcionales (descomentar solo con valores reales) ───────────────────────────

# Remitente del CRM. Sin definir usa EMAIL_USER (el mismo del calendario). Si se
# pone, debe ser del MISMO dominio que EMAIL_USER o el relay puede rechazarlo.
# CRM_SMTP_FROM="Reforma Dental <noreply@your-domain.com>"

# Facebook Conversions API: reporta los cambios de etapa a Meta. Sin token no se
# pierde nada mas que la atribucion.
# CRM_FB_CAPI_ACCESS_TOKEN=your_conversions_api_access_token
# OJO: con CUALQUIER valor aqui, Meta recibe los eventos en modo prueba y NO los
# cuenta. Dejar comentada en produccion.
# CRM_FB_CAPI_TEST_EVENT_CODE=TEST12345

# WhatsApp Cloud API (Meta). El Phone Number ID es numerico.
# CRM_WHATSAPP_ACCESS_TOKEN=your_whatsapp_permanent_access_token
# CRM_WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# SMS por Twilio. Ademas requiere instalar el paquete: npm install twilio
# CRM_TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# CRM_TWILIO_AUTH_TOKEN=your_twilio_auth_token
# CRM_TWILIO_FROM_SMS_NUMBER=+15550001234

# Cron job para limpiar leads antiguos (por ejemplo, cada 24h). Sin token no se ejecuta.
CRM_CRON_TOKEN=12435465767
